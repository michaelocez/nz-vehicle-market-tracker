{
  "name": "nz-vehicle-market-tracker-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:data": "node scripts/sync-data.mjs",
    "predev": "npm run sync:data",
